// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- KANBAN MODELS ----------
model KanbanBoard {
  id          Int           @id @default(autoincrement())
  titulo      String
  creadoEn    DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")
  columnas    KanbanColumn[]
  creadorId   Int           @map("creador_id")
  creador     Usuario       @relation(fields: [creadorId], references: [id])

  @@map("kanban_board")
}

model KanbanColumn {
  id          Int           @id @default(autoincrement())
  titulo      String
  orden       Int           @default(0)
  boardId     Int           @map("board_id")
  board       KanbanBoard   @relation(fields: [boardId], references: [id])
  tarjetas    KanbanCard[]

  @@map("kanban_column")
}

model KanbanCard {
  id          Int           @id @default(autoincrement())
  titulo      String
  descripcion String?
  orden       Int           @default(0)
  columnaId   Int           @map("columna_id")
  columna     KanbanColumn   @relation(fields: [columnaId], references: [id])
  asignadoAId Int?          @map("asignado_a_id")
  asignadoA   Usuario?      @relation(fields: [asignadoAId], references: [id])
  creadoEn    DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")

  @@map("kanban_card")
}

// ---------- USER & ROLE MODELS ----------
model Usuario {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  email         String     @unique
  password      String
  activo        Boolean    @default(true)
  rolId         Int
  rol           RolUsuario @relation(fields: [rolId], references: [id])
  // relaciones opcionales
  kanbanBoards  KanbanBoard[]
  kanbanCards   KanbanCard[]
}

model RolUsuario {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique
  descripcion String?
  usuarios    Usuario[]
  permissions RolPermission[]
}

// ---------- PERMISSION MODELS ----------
model Permission {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  descripcion String?
  roles       RolPermission[]
}

model RolPermission {
  rolId        Int
  permissionId Int

  rol          RolUsuario   @relation(fields: [rolId], references: [id])
  permission   Permission   @relation(fields: [permissionId], references: [id])

  @@id([rolId, permissionId])
}
